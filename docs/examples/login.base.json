      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "action": "返回不暴露账户存在性的错误说明"
      }
    },
    {
      "id": "rule-credential",
      "kind": "rule",
      "title": "凭证验证规则",
      "summary": "只有凭证有效才允许成功",
      "parentId": "flow-login",
      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "when": "执行凭证检查时",
        "constraint": "有效凭证进入成功；无效凭证或验证依赖不可用进入失败",
        "exceptions": [
          "不得将依赖故障标记为密码错误"
        ],
        "rationale": "明确成功、拒绝及不可用的不同原因"
      }
    },
    {
      "id": "acc-success",
      "kind": "acceptance",
      "title": "有效凭证可登录",
      "summary": "验证正常成功路径",
      "parentId": "flow-login",
      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "given": [
          "有效凭证",
          "验证依赖可用"
        ],
        "when": "提交登录请求",
        "then": [
          "到达 step-success"
        ]
      }
    },
    {
      "id": "acc-failure",
      "kind": "acceptance",
      "title": "无效凭证被拒绝",
      "summary": "验证正常拒绝路径",
      "parentId": "flow-login",
      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "given": [
          "无效凭证",
          "验证依赖可用"
        ],
        "when": "提交登录请求",
        "then": [
          "到达 step-failure",
          "错误说明不暴露账户是否存在"
        ]
      }
    }
