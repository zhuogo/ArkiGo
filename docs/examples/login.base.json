      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "action": "返回成功结果；会话创建细节不在此示例范围"
      }
    },
    {
      "id": "step-failure",
      "kind": "step",
      "title": "返回失败",
      "summary": "返回失败结果并结束本次流程",
