      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "audience": [
          "示例用户"
        ],
        "inScope": [
          "凭证登录"
        ],
        "outOfScope": [
          "注册",
          "找回密码",
          "真实账户存储"
        ],
        "successCriteria": [
          "可追踪一次登录设计变化"
        ]
      }
    },
    {
      "id": "mod-user",
      "kind": "module",
      "title": "用户模块",
      "summary": "负责演示用户身份相关能力",
      "parentId": "sys-demo",
      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "responsibilities": [
          "组织登录能力"
        ],
        "boundaries": [
          "账户存储实现不在此示例范围"
        ],
        "inputs": [
          "登录请求"
        ],
        "outputs": [
          "登录结果"
        ]
      }
    },
    {
      "id": "flow-login",
      "kind": "flow",
      "title": "登录流程",
      "summary": "先检查尝试限制，再验证凭证并返回结果",
      "parentId": "mod-user",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "trigger": "用户提交凭证",
        "preconditions": [
          "凭证输入已完成基础格式检查"
        ],
        "startStepId": "step-receive",
        "terminalStepIds": [
          "step-success",
          "step-failure"
        ]
      }
    },
    {
      "id": "step-receive",
      "kind": "step",
      "title": "接收请求",
      "summary": "读取凭证并进入限流检查",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "action": "读取登录输入并进入限流检查",
        "inputs": [
          "凭证"
        ],
        "outputs": [
          "待验证凭证"
        ]
      }
    },
    {
      "id": "step-credential",
      "kind": "step",
      "title": "检查凭证",
      "summary": "验证凭证，并按规则更新失败计数",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "action": "调用凭证验证能力；有效时清零，密码无效时累计失败计数",
        "outputs": [
          "valid",
          "invalid"
        ],
        "failureHandling": "验证依赖不可用时进入失败结果，不增加密码失败计数"
      }
    },
    {
      "id": "step-success",
      "kind": "step",
      "title": "返回成功",
      "summary": "确认本次登录成功",
      "parentId": "flow-login",
      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "action": "返回成功结果；会话创建细节不在此示例范围"
      }
    },
    {
      "id": "step-failure",
      "kind": "step",
      "title": "返回失败",
      "summary": "处理凭证失败、验证不可用或暂时限制",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "action": "返回不暴露账户存在性的错误说明"
      }
    },
    {
      "id": "rule-credential",
      "kind": "rule",
      "title": "凭证验证规则",
      "summary": "只有凭证有效才允许成功",
      "parentId": "flow-login",
      "designStatus": "accepted",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "when": "执行凭证检查时",
        "constraint": "有效凭证进入成功；无效凭证或验证依赖不可用进入失败",
        "exceptions": [
          "不得将依赖故障标记为密码错误"
        ],
        "rationale": "明确成功、拒绝及不可用的不同原因"
      }
    },
    {
      "id": "acc-success",
      "kind": "acceptance",
      "title": "有效凭证可登录",
      "summary": "验证正常成功路径",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "given": [
          "有效凭证",
          "验证依赖可用",
          "当前不受尝试限制"
        ],
        "when": "提交登录请求",
        "then": [
          "到达 step-success"
        ]
      }
    },
    {
      "id": "acc-failure",
      "kind": "acceptance",
      "title": "无效凭证被拒绝",
      "summary": "验证正常拒绝路径",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "given": [
          "无效凭证",
          "验证依赖可用",
          "当前不受尝试限制"
        ],
        "when": "提交登录请求",
        "then": [
          "到达 step-failure",
          "错误说明不暴露账户是否存在"
        ]
      }
    },
    {
      "id": "step-limit",
      "kind": "step",
      "title": "检查尝试限制",
      "summary": "限制有效时不执行凭证验证",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "action": "按待决定的计数主体检查限制状态；期满时清零并继续验证",
        "outputs": [
          "allowed",
          "blocked"
        ],
        "failureHandling": "计数存储不可用时返回暂时不可用，不绕过限制"
      }
    },
    {
      "id": "rule-limit",
      "kind": "rule",
      "title": "连续失败限制",
      "summary": "连续五次失败后限制十分钟",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "when": "同一计数主体尝试凭证登录",
        "constraint": "密码验证连续失败达到五次后，后续请求在十分钟内不得执行凭证验证；成功或锁定期满时清零",
        "exceptions": [
          "验证依赖故障不增加密码失败计数",
          "计数存储不可用时终止本次登录并返回暂时不可用"
        ],
        "rationale": "仅用于演示跨步骤规则及待决策项"
      }
    },
    {
      "id": "acc-limit",
      "kind": "acceptance",
      "title": "达到阈值后阻止验证",
      "summary": "验证限制生效路径",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "given": [
          "同一计数主体连续五次密码验证失败",
          "限制尚未到期"
        ],
        "when": "再次提交登录请求",
        "then": [
          "到达 step-failure",
          "不调用凭证验证能力"
        ]
      }
    },
    {
      "id": "acc-recovery",
      "kind": "acceptance",
      "title": "限制期满后重新验证",
      "summary": "验证限制解除路径",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "given": [
          "该计数主体限制已到期"
        ],
        "when": "提交登录请求",
        "then": [
          "失败计数清零",
          "允许进入 step-credential",
          "仍需凭证有效才可成功"
        ]
      }
    },
    {
      "id": "q-limit-key",
      "kind": "question",
      "title": "如何定义计数主体",
      "summary": "账号还是账号与来源 IP 的组合",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "question": "采用哪个限流计数主体？",
        "options": [
          "账号",
          "账号与来源 IP 组合"
        ],
        "blocks": [
          "限流键设计与最终验收"
        ]
      }
    },
    {
      "id": "q-limit-store",
      "kind": "question",
      "title": "计数是否跨实例共享",
      "summary": "部署形态尚未给定",
      "parentId": "flow-login",
      "designStatus": "proposed",
      "provenance": {
        "origin": "example",
        "references": [
          "README.md"
        ]
      },
      "details": {
        "question": "首版是否需要多个应用实例共享失败计数？",
        "options": [
          "单实例",
          "多实例共享"
        ],
        "blocks": [
          "计数存储及并发规则"
        ]
      }
    }
  ],
