    "scope": [
      "凭证登录流程"
    ],
    "assumptions": [
      "纯演示数据；不代表真实需求或实际实现"
    ]
  },
  "revision": "example-login-v2-candidate",
  "nodes": [
    {
      "id": "sys-demo",
      "kind": "system",
      "title": "示例 Web 应用",
