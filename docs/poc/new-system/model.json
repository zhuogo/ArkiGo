      "designStatus": "proposed",
      "provenance": {
        "origin": "ai",
        "references": [
          "docs/poc/new-system/request.md"
        ]
      },
      "details": {
        "action": "读取用户输入，进入内容检查"
      }
    },
    {
      "id": "step-check",
      "kind": "step",
      "title": "检查标题",
      "summary": "空白内容不应成为任务",
