      "kind": "acceptance",
      "title": "空白标题被拒绝",
      "summary": "预期行为；本对象不代表验收已执行",
      "parentId": "flow-create",
      "designStatus": "proposed",
      "provenance": {
        "origin": "ai",
        "references": [
          "docs/poc/new-system/request.md"
        ]
      },
      "details": {
        "given": [
          "标题只有空格"
        ],
        "when": "点击添加",
        "then": [
          "没有创建任务",
          "输入仍可编辑"
        ]
      }
    },
    {
      "id": "acc-save",
      "kind": "acceptance",
      "title": "成功保存后显示任务",
