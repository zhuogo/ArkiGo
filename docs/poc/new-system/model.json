      "designStatus": "proposed",
      "provenance": {
        "origin": "ai",
        "references": [
          "docs/poc/new-system/request.md"
        ]
      },
      "details": {
        "when": "执行本流程时",
        "constraint": "去掉首尾空白后标题为空时不保存任务",
        "exceptions": [],
        "rationale": "POC 设计建议"
      }
    },
    {
      "id": "rule-result",
      "kind": "rule",
      "title": "保存成功才显示成功",
      "summary": "保存失败时保留输入并允许重试；只有保存成功才清空输入",
      "parentId": "flow-create",
      "designStatus": "proposed",
      "provenance": {
        "origin": "ai",
        "references": [
          "docs/poc/new-system/request.md"
