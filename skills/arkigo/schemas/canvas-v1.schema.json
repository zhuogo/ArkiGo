{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArkiGo canvas v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "title", "description", "views"],
  "properties": {
    "schemaVersion": { "const": "arkigo-canvas/1" },
    "id": { "$ref": "#/definitions/id" },
    "revision": { "$ref": "#/definitions/text" },
    "title": { "$ref": "#/definitions/text" },
    "description": { "type": "string" },
    "rootViewId": { "$ref": "#/definitions/id", "description": "Optional root view; defaults to the first view. targetViewId links form a rooted module tree." },
    "views": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/view" } }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "x": { "type": "number", "minimum": 0, "maximum": 20000 },
    "width": { "type": "number", "minimum": 180, "maximum": 3000 },
    "height": { "type": "number", "minimum": 120, "maximum": 10000 },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "x", "y", "width", "height"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/text" },
        "x": { "$ref": "#/definitions/x" },
        "y": { "$ref": "#/definitions/x" },
        "width": { "$ref": "#/definitions/width" },
        "height": { "$ref": "#/definitions/height" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "zones", "nodes", "edges", "walkthrough"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/text" },
        "subtitle": { "type": "string" },
        "zones": { "type": "array", "items": { "$ref": "#/definitions/box" } },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } },
        "walkthrough": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["nodeId", "title", "text"],
            "properties": {
              "nodeId": { "$ref": "#/definitions/id" },
              "title": { "$ref": "#/definitions/text" },
              "text": { "$ref": "#/definitions/text" },
              "edgeId": { "$ref": "#/definitions/id" }
            }
          }
        }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "kind", "x", "y", "details", "sources"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/text" },
        "summary": { "type": "string" },
        "kind": { "$ref": "#/definitions/text" },
        "x": { "$ref": "#/definitions/x" },
        "y": { "$ref": "#/definitions/x" },
        "width": { "$ref": "#/definitions/width" },
        "height": { "type": "number", "minimum": 140, "maximum": 600 },
        "zoneId": { "$ref": "#/definitions/id" },
        "targetViewId": { "$ref": "#/definitions/id" },
        "designStatus": { "enum": ["proposed", "accepted", "retired"] },
        "implementation": { "$ref": "#/definitions/implementation" },
        "sourceOrigin": { "enum": ["user", "ai", "code", "import", "example"] },
        "details": { "type": "object", "additionalProperties": { "type": ["string", "array"], "items": { "type": "string" } } },
        "sources": { "type": "array", "items": { "$ref": "#/definitions/text" } }
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["planned", "partial", "implemented", "unknown"] },
        "note": { "$ref": "#/definitions/text" },
        "sources": { "type": "array", "items": { "$ref": "#/definitions/text" } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "enum": ["partial", "implemented"] } } }, "then": { "required": ["sources"], "properties": { "sources": { "type": "array", "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "partial" } } }, "then": { "required": ["note"], "properties": { "note": { "$ref": "#/definitions/text" } } } }
      ]
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "maxLength": 80 },
        "kind": { "$ref": "#/definitions/text" },
        "fromSide": { "enum": ["left", "right", "top", "bottom"] },
        "toSide": { "enum": ["left", "right", "top", "bottom"] }
      }
    }
  }
}
