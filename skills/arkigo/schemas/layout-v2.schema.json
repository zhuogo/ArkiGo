{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layout-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "arkigo-layout/2"
    },
    "views": {
      "type": "object",
      "propertyNames": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"x":{"type":"number"},"y":{"type":"number"}},
          "required": ["x","y"]
        }
      }
    }
  },
  "required": [
    "format",
    "views"
  ]
}
