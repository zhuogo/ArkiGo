{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArkiGo model 0.1-draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "revision", "nodes", "relations"],
  "properties": {
    "schemaVersion": { "const": "0.1-draft" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "scope", "assumptions"],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "title": { "$ref": "#/definitions/text" },
        "goal": { "$ref": "#/definitions/text" },
        "scope": { "$ref": "#/definitions/texts" },
        "assumptions": { "$ref": "#/definitions/texts" }
      }
    },
    "revision": { "$ref": "#/definitions/text" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/definitions/relation" }
    }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "texts": { "type": "array", "items": { "$ref": "#/definitions/text" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "references"],
      "properties": {
        "origin": { "enum": ["user", "ai", "code", "import", "example"] },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/text" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "parentId", "designStatus", "provenance", "details"],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "kind": { "enum": ["system", "module", "flow", "step", "rule", "acceptance", "question"] },
        "title": { "$ref": "#/definitions/text" },
        "summary": { "$ref": "#/definitions/text" },
        "parentId": { "type": ["string", "null"], "pattern": "\\S" },
        "designStatus": { "enum": ["proposed", "accepted", "retired"] },
        "provenance": { "$ref": "#/definitions/provenance" },
        "details": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "system" } } }, "then": { "properties": { "details": { "$ref": "#/definitions/system" } } } },
        { "if": { "properties": { "kind": { "const": "module" } } }, "then": { "properties": { "details": { "$ref": "#/definitions/module" } } } },
        { "if": { "properties": { "kind": { "const": "flow" } } }, "then": { "properties": { "details": { "$ref": "#/definitions/flow" } } } },
        { "if": { "properties": { "kind": { "const": "step" } } }, "then": { "properties": { "details": { "$ref": "#/definitions/step" } } } },
        { "if": { "properties": { "kind": { "const": "rule" } } }, "then": { "properties": { "details": { "$ref": "#/definitions/rule" } } } },
        { "if": { "properties": { "kind": { "const": "acceptance" } } }, "then": { "properties": { "details": { "$ref": "#/definitions/acceptance" } } } },
        { "if": { "properties": { "kind": { "const": "question" } } }, "then": { "properties": { "details": { "$ref": "#/definitions/question" } } } }
      ]
    },
    "system": {
      "type": "object",
      "required": ["audience", "inScope", "outOfScope", "successCriteria"],
      "properties": {
        "audience": { "$ref": "#/definitions/texts" },
        "inScope": { "$ref": "#/definitions/texts" },
        "outOfScope": { "$ref": "#/definitions/texts" },
        "successCriteria": { "$ref": "#/definitions/texts" }
      }
    },
    "module": {
      "type": "object",
      "required": ["responsibilities", "boundaries", "inputs", "outputs"],
      "properties": {
        "responsibilities": { "$ref": "#/definitions/texts" },
        "boundaries": { "$ref": "#/definitions/texts" },
        "inputs": { "$ref": "#/definitions/texts" },
        "outputs": { "$ref": "#/definitions/texts" }
      }
    },
    "flow": {
      "type": "object",
      "required": ["trigger", "preconditions", "startStepId", "terminalStepIds"],
      "properties": {
        "trigger": { "$ref": "#/definitions/text" },
        "preconditions": { "$ref": "#/definitions/texts" },
        "startStepId": { "$ref": "#/definitions/text" },
        "terminalStepIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/text" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/definitions/text" },
        "inputs": { "$ref": "#/definitions/texts" },
        "outputs": { "$ref": "#/definitions/texts" },
        "failureHandling": { "$ref": "#/definitions/text" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["when", "constraint", "exceptions", "rationale"],
      "properties": {
        "when": { "$ref": "#/definitions/text" },
        "constraint": { "$ref": "#/definitions/text" },
        "exceptions": { "$ref": "#/definitions/texts" },
        "rationale": { "$ref": "#/definitions/text" }
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["given", "when", "then"],
      "properties": {
        "given": { "$ref": "#/definitions/texts" },
        "when": { "$ref": "#/definitions/text" },
        "then": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } }
      }
    },
    "question": {
      "type": "object",
      "required": ["question", "options", "blocks"],
      "properties": {
        "question": { "$ref": "#/definitions/text" },
        "options": { "$ref": "#/definitions/texts" },
        "blocks": { "$ref": "#/definitions/texts" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": { "$ref": "#/definitions/text" },
        "kind": { "enum": ["depends_on", "governed_by", "verifies", "next", "questions"] },
        "from": { "$ref": "#/definitions/text" },
        "to": { "$ref": "#/definitions/text" },
        "label": { "$ref": "#/definitions/text" },
        "condition": { "$ref": "#/definitions/text" },
        "provenance": { "$ref": "#/definitions/provenance" }
      }
    }
  }
}
